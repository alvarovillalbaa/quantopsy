# INACTIVE EXAMPLE. Root replaces the preparation SHA before publishing the
# reviewed branch-scoped temporary workflow; this file itself cannot run.
name: Quantopsy public GGUF observation 1
on: create
permissions:
  contents: read
concurrency:
  group: quantopsy-artifacts-20261107-1
  cancel-in-progress: false
jobs:
  public-gguf-observation:
    if: >-
      github.event.ref_type == 'branch' &&
      github.event.ref == 'qa/quantopsy-artifacts-20261107-1' &&
      github.repository == 'alvarovillalbaa/quantopsy' &&
      github.event.repository.private == false
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    env:
      CI: 'true'
      SOURCE_COMMIT: PREPARATION_SHA_REPLACED_BY_ROOT
      QUANTOPSY_ARTIFACT_PUBLIC_REPOSITORY: 'true'
    steps:
      - name: Record earliest owned job step
        shell: bash
        run: echo "QUANTOPSY_ARTIFACT_JOB_STARTED_MS=$(date +%s%3N)" >> "$GITHUB_ENV"
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: ${{ env.SOURCE_COMMIT }}
          fetch-depth: 2
          persist-credentials: false
          clean: false
      - name: Observe three pinned public containers with the existing CLI
        shell: bash
        run: python3 -I -B -S tests/scripts/run-public-gguf-observation.py --source-commit "$SOURCE_COMMIT"
